{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=Ecommerce;Username=postgres;Password=12345; Include Error Detail=true"
  },
  "Jwt": {
    "Key": "SuperSecretKeyForJWTEcommerceProject2026!",
    "Issuer": "Ecommerce.API",
    "Audience": "Ecommerce.Client",
    "ExpiryInDays": 7
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/EcommerceLog-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Ecommerce.API"
    }
  },
  "AllowedHosts": "*"
}
